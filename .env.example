# Flask Configuration
SECRET_KEY=coaching-secret-key-change-in-production-2026
FLASK_DEBUG=True
PORT=5000

# MongoDB Configuration
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/coaching_db
# MongoDB Atlas (Cloud) Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/coaching_db?retryWrites=true&w=majority

DB_NAME=coaching_db

# Admin Initial Credentials (seeded on first run if no users exist)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Admin Principal
